# Copy to .env for local work (netlify dev loads it). Production values live in
# Netlify > Site settings > Environment variables, context "production".

# Neon Postgres (pooled connection string for the branch: main = production, dev = local)
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon Managed Better Auth (per branch; from the Neon console or `provision_neon_auth`)
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# 32+ random characters: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Where the site lives. Used for links in emails and Stripe redirects.
PUBLIC_SITE_URL=https://sjwg.netlify.app

# Resend (email). onboarding@resend.dev delivers only to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM=St. Joseph the Worker Guild <onboarding@resend.dev>
# Who gets new help requests and form submissions
GUILD_INTAKE_EMAIL=
GUILD_NOTIFY_EMAIL=

# Stripe. Test keys until the account is activated. DONATIONS_LIVE shows the Give button.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DONATIONS_LIVE=false

# Receipts
ORG_LEGAL_NAME=St. Joseph the Worker Guild
ORG_EIN=

# Netlify Blobs store for photos and logos: "uploads" in production, "uploads-dev" elsewhere
UPLOADS_STORE=uploads-dev

# Netlify build hook (Site settings > Build & deploy > Build hooks). Publishing content calls it.
NETLIFY_BUILD_HOOK_URL=

# Neon Management API, only for scripts/ (optional)
NEON_API_KEY=
NEON_PROJECT_ID=floral-rice-20425383
