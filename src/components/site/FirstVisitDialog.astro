---
/**
 * Email-list popup. Native <dialog> opened non-modally after the visitor has
 * had a moment with the page (8 seconds or a third of the way down, whichever
 * comes first). Not shown on the request-help, portal, or login pages, to
 * anyone already signed up, or for 30 days after "No thanks".
 */
import SubscribeForm from '@/components/forms/SubscribeForm';
import Tk from '@/components/ui/Tk.astro';
import { TK } from '@/config/site';
---

<dialog
  id="welcome"
  class="welcome fixed z-50 m-0 max-h-none w-full max-w-none border-0 bg-charcoal p-0 text-stone shadow-none"
  aria-labelledby="welcome-title"
  aria-describedby="welcome-body"
>
  <div class="relative border-t-4 border-brass px-5 py-5 md:px-8 md:py-7">
    <button
      type="button"
      class="absolute top-3 right-3 p-2 font-sans text-[1.4rem] leading-none text-stone/70 hover:text-stone"
      aria-label="Close"
      data-close
    >
      ×
    </button>
    <h2
      id="welcome-title"
      tabindex="-1"
      class="pr-8 text-[1.4rem] leading-tight outline-none md:text-[1.8rem]"
    >
      Stay Close to the Guild
    </h2>
    <p
      id="welcome-body"
      class="mt-2 max-w-[44ch] font-sans text-[0.95rem] leading-relaxed text-stone/85 md:mt-3 md:text-[1rem]"
    >
      Holy hours, work days, and Guild news from Saint Mary of Victories, about once a month. No
      spam, ever.
    </p>
    <div class="mt-4 md:mt-5">
      <SubscribeForm client:idle source="popup" tone="dark" withName submitLabel="Count me in" />
    </div>
    <p class="mt-4 font-sans text-[0.8rem] leading-relaxed text-stone/65">
      The Guild is a Catholic nonprofit. <Tk {...TK.taxStatus} />
    </p>
    <button
      type="button"
      class="mt-3 font-sans text-[0.9rem] font-medium underline decoration-brass decoration-2 underline-offset-4"
      data-close
    >
      No thanks
    </button>
  </div>
</dialog>

<style>
  .welcome {
    /* Bottom sheet on small screens, corner panel on larger ones. */
    inset: auto 0 0 0;
  }
  @media (min-width: 48rem) {
    .welcome {
      inset: auto 1.5rem 1.5rem auto;
      width: min(30rem, calc(100% - 3rem));
    }
  }
  .welcome[open] {
    animation: welcome-in 220ms ease-out;
  }
  @keyframes welcome-in {
    from {
      transform: translateY(12px);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }
</style>

<script>
  const DISMISSED = 'sjwg:v2:signup-dismissed';
  const SUBSCRIBED = 'sjwg:v1:subscribed';
  const QUIET_DAYS = 30;
  const dialog = document.getElementById('welcome') as HTMLDialogElement | null;

  function read(key: string): { at?: string } | null {
    try {
      const v = localStorage.getItem(key);
      return v ? JSON.parse(v) : null;
    } catch {
      return null;
    }
  }
  function write(key: string) {
    try {
      localStorage.setItem(key, JSON.stringify({ at: new Date().toISOString() }));
    } catch {
      /* storage unavailable: the popup may show again, which is fine */
    }
  }
  function shouldShow(): boolean {
    if (read(SUBSCRIBED)) return false;
    const d = read(DISMISSED);
    if (!d?.at) return true;
    return Date.now() - Date.parse(d.at) > QUIET_DAYS * 24 * 60 * 60 * 1000;
  }

  const skip = ['/request', '/portal', '/login', '/invite', '/forgot-password', '/reset-password'];
  if (dialog && !skip.some((p) => location.pathname.startsWith(p)) && shouldShow()) {
    let timer = 0;
    // Opens at most once per page view; after that only the footer form remains.
    let shown = false;
    // The footer has its own sign-up; never cover it with this one.
    const footerSignup = document.getElementById('footer-signup-title')?.closest('section');
    const footerInView = () => {
      if (!footerSignup) return false;
      const r = footerSignup.getBoundingClientRect();
      return r.top < window.innerHeight && r.bottom > 0;
    };
    const stop = () => {
      window.clearTimeout(timer);
      window.removeEventListener('scroll', onScroll);
    };
    const open = () => {
      if (shown || dialog.open || footerInView()) return;
      shown = true;
      window.clearTimeout(timer);
      // Non-modal on purpose: the page stays usable and nothing is dimmed.
      dialog.show();
      dialog.querySelector<HTMLElement>('#welcome-title')?.focus({ preventScroll: true });
    };
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      // While the footer sign-up is on screen, step aside rather than cover it.
      if (dialog.open) dialog.style.visibility = footerInView() ? 'hidden' : '';
      else if (!shown && max > 0 && window.scrollY / max > 0.33) open();
    };
    const dismiss = () => {
      write(DISMISSED);
      stop();
      dialog.close();
    };
    // Clicking anywhere outside the popup counts as "no thanks".
    document.addEventListener('pointerdown', (e) => {
      if (dialog.open && !dialog.contains(e.target as Node)) dismiss();
    });

    const start = () => {
      timer = window.setTimeout(open, 8000);
      window.addEventListener('scroll', onScroll, { passive: true });
    };
    if (document.readyState === 'complete') start();
    else window.addEventListener('load', start, { once: true });

    dialog.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', dismiss));
    // Non-modal dialogs do not get the cancel event, so handle Escape here.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dialog.open) dismiss();
    });
    // Signed up anywhere on the page: thank him, then get out of the way.
    window.addEventListener('sjwg:subscribed', () => {
      stop();
      if (dialog.open) window.setTimeout(() => dialog.close(), 2500);
    });
  }
</script>
