---
import Wordmark from '@/components/brand/Wordmark.astro';
import Button from '@/components/ui/Button.astro';
import { DONATE_URL } from '@/config/site';

const links = [
  { href: '/directory', label: 'Directory' },
  { href: '/events', label: 'Events' },
  { href: '/about', label: 'About' },
  { href: '/get-involved', label: 'Get involved' },
  { href: '/contact', label: 'Contact' },
];
const current = Astro.url.pathname;
const isCurrent = (href: string) => current === href || current.startsWith(href + '/');
---

<header class="border-b border-mortar bg-stone">
  <div class="wrap flex items-center justify-between gap-6 py-4 md:py-5">
    <Wordmark href="/" size="md" />

    <nav aria-label="Main" class="hidden items-center gap-7 lg:flex">
      {links.map((l) => (
        <a
          href={l.href}
          aria-current={isCurrent(l.href) ? 'page' : undefined}
          class:list={[
            'font-sans text-[1rem] font-medium no-underline hover:underline decoration-brass decoration-2 underline-offset-[6px]',
            isCurrent(l.href) && 'underline',
          ]}
        >
          {l.label}
        </a>
      ))}
      <a
        href="/login"
        class="font-sans text-[1rem] font-medium text-ash no-underline hover:underline"
      >
        Log in
      </a>
      <Button
        href={DONATE_URL === '#donate-placeholder' ? '/donate' : DONATE_URL}
        variant="secondary"
      >
        Donate
      </Button>
    </nav>

    <button
      type="button"
      class="inline-flex items-center gap-2 border-2 border-charcoal px-4 py-2.5 font-sans font-semibold leading-none lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span data-menu-label>Menu</span>
      <svg
        width="18"
        height="18"
        viewBox="0 0 18 18"
        aria-hidden="true"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M2 4h14M2 9h14M2 14h14" data-icon-open class="block"></path>
        <path d="M4 4l10 10M14 4L4 14" data-icon-close class="hidden"></path>
      </svg>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Main, mobile"
    class="border-t border-mortar bg-paper lg:hidden"
    hidden
  >
    <ul class="wrap flex flex-col py-2">
      {links.map((l) => (
        <li class="border-b border-mortar last:border-b-0">
          <a
            href={l.href}
            aria-current={isCurrent(l.href) ? 'page' : undefined}
            class="block py-4 font-sans text-[1.125rem] font-medium no-underline"
          >
            {l.label}
          </a>
        </li>
      ))}
      <li class="border-b border-mortar">
        <a
          href="/login"
          class="block py-4 font-sans text-[1.125rem] font-medium text-ash no-underline"
        >
          Log in
        </a>
      </li>
      <li class="py-4">
        <Button
          href={DONATE_URL === '#donate-placeholder' ? '/donate' : DONATE_URL}
          variant="secondary"
          class="w-full"
        >
          Donate
        </Button>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  const label = toggle?.querySelector('[data-menu-label]');
  const iconOpen = toggle?.querySelector('[data-icon-open]');
  const iconClose = toggle?.querySelector('[data-icon-close]');

  function setOpen(open: boolean) {
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    if (label) label.textContent = open ? 'Close' : 'Menu';
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  }

  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
      toggle.focus();
    }
  });
</script>
