---
import Wordmark from '@/components/brand/Wordmark.astro';
import Tk from '@/components/ui/Tk.astro';
import SubscribeForm from '@/components/forms/SubscribeForm';
import { PARISH_NAME, PARISH_CITY, TK, PARISH_STREET, PARISH_ZIP } from '@/config/site';

const year = new Date().getFullYear();
const cols = [
  {
    heading: 'Visit',
    links: [
      { href: '/directory', label: 'Member directory' },
      { href: '/events', label: 'Events' },
      { href: '/about', label: 'About the Guild' },
      { href: '/blog', label: 'Blog' },
    ],
  },
  {
    heading: 'Take part',
    links: [
      { href: '/request', label: 'Request help' },
      { href: '/get-involved', label: 'Join as a tradesman' },
      { href: '/donate', label: 'Give' },
      { href: '/contact', label: 'Contact and partnerships' },
    ],
  },
];
---

<footer class="bg-charcoal text-stone">
  <section aria-labelledby="footer-signup-title" class="border-b border-stone/15">
    <div class="wrap grid gap-6 py-10 md:grid-cols-[1fr_1.1fr] md:items-center md:gap-12 md:py-12">
      <div>
        <h2 id="footer-signup-title" class="text-[1.6rem] leading-tight md:text-[2rem]">
          Stay Close to the Guild
        </h2>
        <p class="mt-2 max-w-[46ch] font-sans leading-relaxed text-stone/80">
          Holy hours, work days, and Guild news, about once a month. No spam, ever.
        </p>
      </div>
      <SubscribeForm client:visible source="footer" tone="dark" submitLabel="Sign up" />
    </div>
  </section>
  <div class="wrap grid gap-12 py-14 md:grid-cols-[1.4fr_1fr_1fr] md:py-20">
    <div class="flex flex-col gap-6">
      <img
        src="/brand/seal.svg"
        alt=""
        width="1024"
        height="1024"
        class="h-28 w-28 md:h-32 md:w-32"
        loading="lazy"
        decoding="async"
      />
      <Wordmark size="lg" tone="light" withParish />
      <address class="max-w-[38ch] font-sans not-italic leading-relaxed text-stone/85">
        {PARISH_NAME}
        <br />
        {PARISH_STREET}
        <br />
        {PARISH_CITY} {PARISH_ZIP}
      </address>
    </div>

    {cols.map((c) => (
      <nav aria-label={c.heading}>
        <h2 class="mb-4 font-sans text-[0.95rem] font-semibold text-brass-glow">{c.heading}</h2>
        <ul class="flex flex-col gap-2.5">
          {c.links.map((l) => (
            <li>
              <a href={l.href} class="font-sans no-underline hover:underline">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <div class="border-t border-stone/15">
    <div class="wrap flex flex-col gap-3 py-6 font-sans text-[0.9rem] text-stone/70 md:flex-row md:items-center md:justify-between">
      <p>
        &copy; {year} St. Joseph the Worker Guild. <Tk {...TK.taxStatus} />
      </p>
      <p>
        <a href="/login" class="no-underline hover:underline">
          Member log in
        </a>
      </p>
    </div>
  </div>
</footer>
