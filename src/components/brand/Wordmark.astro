---
/**
 * The Guild's wordmark: the traced "St. Joseph the Worker Guild" logo with
 * the cross (public/brand/wordmark-*.svg, from ~/Custom/sjwg-logos, set C).
 * The ONLY place the Guild's name is set as a mark; swap the files to change it.
 */
interface Props {
  size?: 'sm' | 'md' | 'lg';
  tone?: 'dark' | 'light';
  href?: string;
  withParish?: boolean;
}
const { size = 'md', tone = 'dark', href, withParish = false } = Astro.props;
// The art is 4339 x 852; heights keep the cross and rules legible.
const heights = { sm: 'h-7', md: 'h-9 md:h-10', lg: 'h-12' };
const src = tone === 'dark' ? '/brand/wordmark-olive.svg' : '/brand/wordmark-ivory.svg';
const color = tone === 'dark' ? 'text-charcoal' : 'text-stone';
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['inline-flex flex-col items-start no-underline', color]}>
  <img
    src={src}
    alt="St. Joseph the Worker Guild"
    width="4339"
    height="852"
    class:list={['block w-auto max-w-full', heights[size]]}
    decoding="async"
  />
  {withParish && (
    <span class="mt-2 block font-sans text-[0.8rem] leading-snug text-current/75">
      Saint Mary of Victories, St. Louis
    </span>
  )}
</Tag>
