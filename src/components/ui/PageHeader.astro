---
/**
 * Brick band at the top of every inner page. This is where the page spends
 * its one bold element, so nothing below it uses brick at scale.
 */
interface Props {
  title: string;
  lede?: string;
}
const { title, lede } = Astro.props;
---

<header class="bg-brick text-paper">
  <div class="wrap py-12 md:py-16">
    <h1 class="text-h2 md:text-display max-w-[20ch]">{title}</h1>
    {lede && (
      <p class="mt-5 max-w-[60ch] text-[1.125rem] leading-relaxed text-stone/90 md:text-[1.25rem]">
        {lede}
      </p>
    )}
    <slot />
  </div>
</header>
