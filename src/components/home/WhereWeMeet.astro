---
import Section from '@/components/ui/Section.astro';
import Picture from '@/components/ui/Picture.astro';
import { PARISH_NAME, PARISH_CITY, PARISH_STREET, PARISH_ZIP } from '@/config/site';

const mapsHref =
  'https://www.google.com/maps/search/?api=1&query=' +
  encodeURIComponent(`${PARISH_NAME} ${PARISH_CITY}`);
---

<Section tone="stone" labelledby="meet-title">
  <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16">
    <figure class="m-0">
      <Picture slot="meetingPlace" sizes="(min-width: 64rem) 45vw, 100vw" aspect="4 / 3" />
      <figcaption class="mt-2 font-sans text-[0.8rem] text-ash">
        {'Photo: '}<a href="https://commons.wikimedia.org/wiki/File:Saint_Mary_of_Victories_Church_(St._Louis,_MO)_-_exterior.jpg" class="underline decoration-mortar underline-offset-2">Nheyob</a>{', '}<a href="https://creativecommons.org/licenses/by-sa/4.0" class="underline decoration-mortar underline-offset-2">CC BY-SA 4.0</a>{', via Wikimedia Commons'}
      </figcaption>
    </figure>
    <div>
      <h2 id="meet-title" class="text-h2">
        Where we meet
      </h2>
      <address class="mt-6 not-italic leading-relaxed">
        <p class="font-serif text-[1.25rem]">{PARISH_NAME}</p>
        <p class="mt-1">{PARISH_STREET}</p>
        <p>
          {PARISH_CITY} {PARISH_ZIP}
        </p>
      </address>
      <p class="mt-6 max-w-[52ch] leading-relaxed">
        The Guild meets the first Thursday of every month at 7:00 PM, and keeps a holy hour the
        second Thursday at 6:30 PM, unless the events page says otherwise.
      </p>
      <p class="mt-6">
        <a
          href={mapsHref}
          rel="noopener"
          target="_blank"
          class="font-sans font-semibold underline decoration-brass decoration-2 underline-offset-4 hover:decoration-charcoal"
        >
          Directions to the church (opens in a new tab)
        </a>
      </p>
    </div>
  </div>
</Section>
