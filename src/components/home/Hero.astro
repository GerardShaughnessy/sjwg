---
/**
 * Hero. Olive band, headline left, the Guild seal right
 * (public/brand/seal.svg, logo set A in the brand palette). The promo video, when it
 * exists, can return here.
 */
import Button from '@/components/ui/Button.astro';
---

<section class="bg-charcoal text-stone" aria-labelledby="hero-title">
  <div class="wrap grid gap-10 py-14 md:py-20 lg:grid-cols-[7fr_5fr] lg:items-center lg:gap-14 lg:py-24">
    <div>
      <p class="font-sans text-[1rem] text-brass-glow md:text-[1.05rem]">
        Generously hosted by Saint Mary of Victories, St. Louis, Missouri.
      </p>
      <h1 id="hero-title" class="mt-5">
        <span class="block max-w-[20ch] text-[clamp(2rem,1.1rem+2.7vw,3.3rem)] leading-[1.05] tracking-[-0.015em]">
          A Catholic Community Supporting our Tradesmen
        </span>
        <span class="mt-3 block max-w-[20ch] text-[clamp(2rem,1.1rem+2.7vw,3.3rem)] leading-[1.05] tracking-[-0.015em] text-brass-glow">
          Catholic Tradesmen Supporting our Community
        </span>
        <span class="mt-6 block font-sans text-[clamp(0.95rem,0.85rem+0.4vw,1.15rem)] font-semibold uppercase tracking-[0.18em] text-stone/85">
          Faith. Works. Solidarity.
        </span>
      </h1>
      <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-7">
        <Button href="/request" size="lg">
          Request help from the Guild
        </Button>
        <Button
          href="/donate"
          variant="quiet"
          class="text-stone decoration-brass hover:decoration-stone"
        >
          Support the Guild
        </Button>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <img
        src="/brand/seal.svg"
        alt="The St. Joseph the Worker Guild seal: St. Joseph with hammer and chisel, ringed by Faith, Works, Solidarity and Nonne hic est faber"
        width="1024"
        height="1024"
        class="h-auto w-[min(76vw,24rem)] lg:w-full lg:max-w-[28rem]"
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="h-2 bg-brick" aria-hidden="true"></div>
</section>
