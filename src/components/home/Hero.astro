---
/**
 * Hero. Charcoal band, Caslon headline left, promo video slot right.
 * The video is pending, so the slot ships with the poster only. When a file
 * exists, set data-src-mp4 / data-src-webm on the <video>; the script attaches
 * sources and plays muted only when the visitor allows motion and is not on
 * a data-saver connection. No autoplay or <source> in markup on purpose.
 */
import Button from '@/components/ui/Button.astro';
import Picture from '@/components/ui/Picture.astro';
import Tk from '@/components/ui/Tk.astro';
import { TK } from '@/config/site';
---

<section class="bg-charcoal text-stone" aria-labelledby="hero-title">
  <div class="wrap grid gap-10 py-14 md:py-20 lg:grid-cols-[7fr_5fr] lg:items-center lg:gap-14 lg:py-24">
    <div>
      <p class="font-sans text-[1rem] text-brass md:text-[1.05rem]">
        Catholic tradesmen of Saint Mary of Victories, St. Louis, Missouri.
      </p>
      <h1 id="hero-title" class="mt-5 text-display max-w-[16ch]">
        A brotherhood where Catholic tradesmen and their families can flourish.
      </h1>
      <p class="mt-6 max-w-[52ch] font-sans text-[1.125rem] leading-relaxed text-stone/85 md:text-[1.25rem]">
        Plumbers, electricians, carpenters, and other working men who pray together, trade labor,
        and show up for neighbors who have no one else to call.
      </p>
      <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-7">
        <Button href="/request" size="lg">
          Request help from the Guild
        </Button>
        <Button
          href="/donate"
          variant="quiet"
          class="text-stone decoration-brass hover:decoration-stone"
        >
          Support the Guild
        </Button>
      </div>
    </div>

    <figure class="lg:justify-self-end lg:w-full">
      <div class="relative border-[6px] border-brick bg-kiln">
        <Picture
          slot="heroPoster"
          priority
          sizes="(min-width: 64rem) 40vw, 100vw"
          aspect="4 / 3"
          class="hero-poster"
        />
        <video
          class="absolute inset-0 hidden h-full w-full object-cover"
          muted
          playsinline
          loop
          preload="none"
          aria-hidden="true"
          tabindex="-1"
          data-hero-video
          data-src-mp4=""
          data-src-webm=""
        ></video>
      </div>
      <figcaption class="mt-3 font-sans text-[0.9rem] leading-snug text-stone/70">
        <Tk {...TK.promoVideo} />
      </figcaption>
    </figure>
  </div>
  <div class="h-2 bg-brick" aria-hidden="true"></div>
</section>

<style>
  /* Sit the still into the charcoal band rather than letting it glow. */
  :global(.hero-poster) {
    filter: saturate(0.5) contrast(1.05) brightness(0.92);
  }
</style>

<script>
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const mp4 = video?.dataset.srcMp4;
  const webm = video?.dataset.srcWebm;
  const allowMotion = matchMedia('(prefers-reduced-motion: no-preference)').matches;
  const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection
    ?.saveData;

  if (video && (mp4 || webm) && allowMotion && !saveData) {
    if (webm) {
      const s = document.createElement('source');
      s.src = webm;
      s.type = 'video/webm';
      video.append(s);
    }
    if (mp4) {
      const s = document.createElement('source');
      s.src = mp4;
      s.type = 'video/mp4';
      video.append(s);
    }
    video.load();
    video
      .play()
      .then(() => video.classList.remove('hidden'))
      .catch(() => {
        /* autoplay refused: the poster stays, which is fine */
      });
  }
</script>
