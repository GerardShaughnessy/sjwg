---
/**
 * Hero. Olive band, headline left, the circular SJWG monogram right
 * (public/brand/monogram-ivory.svg, logo set E). The promo video, when it
 * exists, can return here.
 */
import Button from '@/components/ui/Button.astro';
---

<section class="bg-charcoal text-stone" aria-labelledby="hero-title">
  <div class="wrap grid gap-10 py-14 md:py-20 lg:grid-cols-[7fr_5fr] lg:items-center lg:gap-14 lg:py-24">
    <div>
      <p class="font-sans text-[1rem] text-brass-glow md:text-[1.05rem]">
        Generously hosted by Saint Mary of Victories, St. Louis, Missouri.
      </p>
      <h1
        id="hero-title"
        class="mt-5 max-w-[22ch] text-[clamp(2rem,1.1rem+2.8vw,3.4rem)] leading-[1.08] tracking-[-0.01em]"
      >
        A Catholic brotherhood of devout local tradesmen who unite their families, communities,
        and parishes in solidarity.
      </h1>
      <div class="mt-9 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:gap-7">
        <Button href="/request" size="lg">
          Request help from the Guild
        </Button>
        <Button
          href="/donate"
          variant="quiet"
          class="text-stone decoration-brass hover:decoration-stone"
        >
          Support the Guild
        </Button>
      </div>
    </div>

    <div class="flex justify-center lg:justify-end">
      <img
        src="/brand/monogram-ivory.svg"
        alt="The St. Joseph the Worker Guild monogram: SJWG within a ring, crowned by a cross"
        width="4673"
        height="4520"
        class="h-auto w-[min(72vw,22rem)] lg:w-full lg:max-w-[26rem]"
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="h-2 bg-brick" aria-hidden="true"></div>
</section>

