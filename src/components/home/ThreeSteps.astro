---
/**
 * The plan (StoryBrand): three plain steps from stranger to listed tradesman, and one
 * line for donors. Dates come from the regular schedule in WhereWeMeet.
 */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';

const steps = [
  {
    n: '1',
    title: 'Come and See',
    text: 'A holy hour (third Thursday, 7:00 PM) or a Guild meeting (first Thursday, 7:00 PM) at Saint Mary of Victories. No commitment.',
  },
  {
    n: '2',
    title: 'Meet the Guild',
    text: 'Talk trade, family, and faith with Catholic tradesmen. An officer will answer your questions about the Guild and the directory.',
  },
  {
    n: '3',
    title: 'Take the Pledge',
    text: 'Take the Ethical Pledge and be listed in the directory, free. We hope you will consider charity work for those in need when the Guild asks.',
  },
];
---

<Section tone="paper" labelledby="steps-title">
  <h2 id="steps-title" class="text-h2">
    Getting Involved Is Simple
  </h2>
  <ol class="mt-8 grid gap-8 border-t border-mortar pt-8 md:grid-cols-3 md:gap-10">
    {steps.map((s) => (
      <li class="flex flex-col gap-3">
        <span
          class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-brass font-serif text-[1.4rem] text-brass-ink"
          aria-hidden="true"
        >
          {s.n}
        </span>
        <h3 class="text-h3">{s.title}</h3>
        <p class="leading-relaxed">{s.text}</p>
      </li>
    ))}
  </ol>
  <div class="mt-10 flex flex-wrap items-center gap-4">
    <Button href="/events">See upcoming events</Button>
    <Button href="/get-involved" variant="quiet">
      Ask about listing
    </Button>
  </div>
  <p class="mt-8 max-w-[64ch] border-t border-mortar pt-6 leading-relaxed text-ash">
    Supporting the Guild is just as simple: you give, the Guild reviews each request for help, and a
    family or parish in need is helped.{' '}
    <a
      href="/donate"
      class="font-semibold text-charcoal underline decoration-brass decoration-2 underline-offset-4"
    >
      See ways to give
    </a>
    .
  </p>
</Section>
