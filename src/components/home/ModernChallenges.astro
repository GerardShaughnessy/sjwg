---
/**
 * The stakes: why tradesmen need a guild (StoryBrand "stakes"). Condensed prose
 * from the Case for Support above the four facts, laid out two by two. The
 * hardship story is kept to one sentence, without figures, until both members
 * have given written consent.
 */
import Section from '@/components/ui/Section.astro';

const facts = [
  {
    term: 'Highest Suicide Rate',
    text: 'The CDC identifies construction and extraction as the occupational group with the highest suicide rate in the nation.',
  },
  {
    term: 'Second in Fatal Injury',
    text: 'Construction and extraction ranks second in fatal workplace injury, with 12.6 deaths per 100,000 workers in 2024, nearly four times the rate across all occupations. This is the Bureau of Labor Statistics figure by occupation group, not by industry.',
  },
  {
    term: 'Isolating Work',
    text: 'Construction ranks among the industries with the highest rates of substance-use disorder, and research increasingly points to loneliness and lack of social support as serious concerns for the trades.',
  },
  {
    term: 'No Safety Net',
    text: "Among the Guild's own members, more than 90% have no employer-sponsored health insurance, and at least 20% have no health coverage at all.",
  },
];
---

<Section tone="paper" labelledby="need-title">
  <div>
    <div>
      <h2 id="need-title" class="text-h2">
        Why Tradesmen Need a Guild
      </h2>
      <div class="mt-5 flex max-w-[60ch] flex-col gap-4 leading-relaxed">
        <p>
          Tradesmen keep the water running, the lights on, and the roofs over our heads. For a
          family of limited means, a small independent tradesman is often the last one willing to
          answer the call.
        </p>
        <p>
          Yet the men who carry others often carry their own burdens alone. Many run one-man shops
          with no employer health plan, no safety net, and no one to call when work slows or a
          crisis hits.
        </p>
        <p>
          We have seen what a brotherhood can do. When one member's family faced a medical emergency
          in his slowest month, fellow Catholics covered the bills within two weeks. The Guild
          exists to make that kind of help ordinary: fair work, faithful friendship, and a community
          rooted in Christ.
        </p>
      </div>
    </div>
    <dl class="mt-10 grid gap-px overflow-hidden border border-mortar bg-mortar sm:grid-cols-2">
      {facts.map((f) => (
        <div class="flex flex-col gap-2 bg-paper p-6 md:p-8">
          <dt class="font-sans text-[1.1rem] font-semibold">{f.term}</dt>
          <dd class="leading-relaxed">{f.text}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-4 font-sans text-[0.85rem] leading-snug text-ash">
      Sources: CDC, suicide rates by occupational group; U.S. Bureau of Labor Statistics, Census
      of Fatal Occupational Injuries, 2024. Membership figures are the Guild's own.
    </p>
  </div>
</Section>
