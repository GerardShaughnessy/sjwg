---
/**
 * Four programs, not a sequence: a ledger with hairline rules, no numbers, no icons.
 * They match the charity's programs in the Articles and the Form 1023.
 */
import Section from '@/components/ui/Section.astro';

const pillars = [
  {
    term: 'Charity Repairs',
    text: 'Free and reduced-cost repairs for low-income, elderly, and disabled neighbors, and donated work for struggling parishes, chapels, schools, and shrines.',
  },
  {
    term: 'Hardship Help',
    text: 'Relief and advocacy for underinsured tradesmen and their families during a medical crisis.',
  },
  {
    term: 'Formation',
    text: 'A monthly holy hour, talks on the dignity of work and Catholic social teaching, an annual retreat, and the St. Joseph the Worker procession each May. All are welcome.',
  },
  {
    term: 'Training the Next Generation',
    text: 'Mentoring and come-and-see visits for young people discerning the trades, and a public directory of practicing Catholic tradesmen who serve the Guild’s charity work.',
  },
];
---

<Section tone="stone" labelledby="pillars-title">
  <h2 id="pillars-title" class="text-h2">
    What the Guild Does
  </h2>
  <dl class="mt-8 border-t border-mortar">
    {pillars.map((p) => (
      <div class="grid gap-2 border-b border-mortar py-6 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-10">
        <dt class="font-serif text-h3">{p.term}</dt>
        <dd class="max-w-[64ch] leading-relaxed">{p.text}</dd>
      </div>
    ))}
  </dl>
</Section>
