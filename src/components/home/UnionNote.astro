---
/**
 * One short band for union readers: the Guild is a brotherhood of faith, not a
 * contractor or a rival to the locals. CONFIRM with the officers that members
 * do in fact include union tradesmen before this goes live.
 */
import Section from '@/components/ui/Section.astro';
---

<Section tone="stone" labelledby="union-title" pad="tight">
  <div class="grid gap-6 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <h2 id="union-title" class="text-h2">
      Union and Independent, Side by Side
    </h2>
    <p class="max-w-[60ch] leading-relaxed">
      Some of our members are proud union tradesmen. Others run one-man shops. The Guild is not a
      contractor and not a rival to the locals. It is a brotherhood of faith, and we are glad to
      work alongside the unions that have looked after working families for generations.
    </p>
  </div>
</Section>
