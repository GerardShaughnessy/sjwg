---
import Section from '@/components/ui/Section.astro';
import Picture from '@/components/ui/Picture.astro';

const { tone = 'stone' } = Astro.props as { tone?: 'stone' | 'paper' };
---

<Section tone={tone} labelledby="what-title">
  <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-16">
    <div>
      <h2 id="what-title" class="text-h2">
        What the Guild Is
      </h2>
      <div class="mt-6 flex max-w-[60ch] flex-col gap-5 leading-relaxed">
        <p>
          Catholic guilds were once at the heart of Christian society: brotherhoods that formed men
          in faith, looked after one another's families, and served their towns.
        </p>
        <p>
          The St. Joseph the Worker Guild brings that tradition home to St. Louis, so that a man's
          work can once again build up his family, his parish, and the city around him.
        </p>
        <p class="font-sans text-[0.95rem] text-ash">
          Consecrated to St. Joseph the Worker and St. Louis IX as patrons.
        </p>
      </div>
    </div>
    <div class="mx-auto w-full max-w-[24rem]">
      <Picture slot="guildAtWork" sizes="24rem" aspect="536 / 893" />
    </div>
  </div>
</Section>
