---
/**
 * Three distinct paths with three distinct treatments. Give is a brick block,
 * Volunteer is an outlined panel, Find is a plain list link into the directory.
 */
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
---

<Section tone="charcoal" labelledby="help-title">
  <h2 id="help-title" class="text-h2">
    How to Help
  </h2>
  <div class="mt-8 grid gap-6 lg:grid-cols-[1.2fr_1fr_1fr] lg:gap-8">
    <div class="flex flex-col justify-between gap-8 bg-brick p-7 md:p-9">
      <div>
        <h3 class="text-h3 md:text-[1.75rem]">Give</h3>
        <p class="mt-3 max-w-[38ch] font-sans leading-relaxed text-stone/90">
          Gifts fund repairs for neighbors in need, parish work days, hardship help for tradesmen's
          families, decided by need, and training for young people entering the trades.
        </p>
      </div>
      <Button href="/donate" variant="inverse">
        See ways to give
      </Button>
    </div>

    <div class="flex flex-col justify-between gap-8 border-2 border-stone/40 p-7 md:p-9">
      <div>
        <h3 class="text-h3 md:text-[1.75rem]">Volunteer</h3>
        <p class="mt-3 max-w-[38ch] font-sans leading-relaxed text-stone/85">
          Catholic men and women, tradesmen or not: join a repair crew or a parish work day. No
          dues, no fees. Bring your skills, or your willingness to haul and clean up.
        </p>
      </div>
      <Button href="/get-involved" variant="inverse">
        Ask about volunteering
      </Button>
    </div>

    <div class="flex flex-col justify-between gap-8 border-t-2 border-brass pt-6 lg:border-t-0 lg:border-l-2 lg:pt-0 lg:pl-8">
      <div>
        <h3 class="text-h3 md:text-[1.75rem]">Find a Catholic Tradesman</h3>
        <p class="mt-3 max-w-[38ch] font-sans leading-relaxed text-stone/85">
          Our directory lists practicing Catholic tradesmen who have signed the Guild's Ethical
          Standards and serve on its charity jobs. Find one by trade and area.
        </p>
        <p class="mt-3 max-w-[42ch] font-sans text-[0.85rem] leading-relaxed text-stone/65">
          The Guild does not employ or guarantee tradesmen. You hire them directly.
        </p>
      </div>
      <a
        href="/directory"
        class="font-sans font-semibold underline decoration-brass decoration-2 underline-offset-4 hover:decoration-stone"
      >
        Browse the directory
      </a>
    </div>
  </div>
</Section>
