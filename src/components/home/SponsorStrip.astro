---
/**
 * Sponsors and partners, grouped by tier. Renders nothing until an officer
 * adds the first active sponsor in the portal, so pages are unchanged until then.
 * Logos are white slabs on stone with a brass hairline, no cards, no shadows.
 */
import { getCollection } from 'astro:content';
import Section from '@/components/ui/Section.astro';

interface Props {
  tone?: 'stone' | 'paper';
  heading?: string;
}
const { tone = 'stone', heading = 'Sponsors and partners' } = Astro.props;

const all = (await getCollection('sponsors')).map((s) => s.data);
const TIERS: { key: (typeof all)[number]['tier']; label: string }[] = [
  { key: 'partner', label: 'Partners' },
  { key: 'sponsor', label: 'Sponsors' },
  { key: 'supporter', label: 'Supporters' },
  { key: 'in-kind', label: 'In-kind support' },
];
const groups = TIERS.map((t) => ({ ...t, items: all.filter((s) => s.tier === t.key) })).filter(
  (g) => g.items.length > 0,
);
const single = groups.length === 1;
---

{all.length > 0 && (
  <Section tone={tone} labelledby="sponsors-title" pad="tight">
    <h2 id="sponsors-title" class="text-h3 md:text-[1.75rem]">
      {heading}
    </h2>
    <p class="mt-2 max-w-[56ch] font-sans text-[0.95rem] text-ash">
      Businesses and organizations that stand behind the Guild's work.
    </p>
    <div class="mt-6 flex flex-col gap-8">
      {groups.map((g) => (
        <div>
          {!single && (
            <h3 class="font-sans text-[0.9rem] font-semibold uppercase tracking-wide text-brass">
              {g.label}
            </h3>
          )}
          <ul class="mt-3 flex flex-wrap gap-3" role="list">
            {g.items.map((s) => {
              const inner = s.logo ? (
                <img
                  src={s.logo}
                  alt={s.logoAlt}
                  width="160"
                  height="80"
                  loading="lazy"
                  decoding="async"
                  class="h-16 w-auto max-w-[10rem] object-contain"
                />
              ) : (
                <span class="font-serif text-[1.15rem] leading-tight">{s.name}</span>
              );
              const cls =
                'flex min-h-[5.5rem] min-w-[10rem] items-center justify-center border-t-2 border-brass bg-paper px-5 py-3 text-charcoal no-underline';
              return (
                <li>
                  {s.url ? (
                    <a
                      href={s.url}
                      rel="noopener sponsored"
                      target="_blank"
                      class={cls}
                      aria-label={s.logo ? `${s.name} (opens their site)` : undefined}
                    >
                      {inner}
                    </a>
                  ) : (
                    <div class={cls}>{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </Section>
)}
