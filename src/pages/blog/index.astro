---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import PostCard from '@/components/blog/PostCard.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => +b.data.pubDate - +a.data.pubDate,
);
---

<BaseLayout
  title="Blog"
  description="News from the St. Joseph the Worker Guild: parish work, member stories, and what the Guild is building."
>
  <PageHeader
    title="From the Guild"
    lede="Short posts on what members are doing and why. Written by members, in plain words."
  />
  <div class="wrap py-10 md:py-14">
    <div class="max-w-[64ch] border-b border-mortar">
      {posts.map((p) => (
        <PostCard id={p.id} {...p.data} />
      ))}
    </div>
    <p class="mt-8 max-w-[60ch] font-sans text-[0.95rem] text-ash">
      Members can draft posts in the{' '}
      <a href="/portal?tab=posts" class="text-charcoal">
        member portal
      </a>
      .
    </p>
  </div>
</BaseLayout>
