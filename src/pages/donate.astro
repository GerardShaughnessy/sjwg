---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Tk from '@/components/ui/Tk.astro';
import SponsorStrip from '@/components/home/SponsorStrip.astro';
import GiveForm from '@/components/donate/GiveForm';

// Built at deploy time: the give form appears once DONATIONS_LIVE is true and Stripe keys exist.
const live = (import.meta.env.DONATIONS_LIVE ?? process.env.DONATIONS_LIVE) === 'true';
import { DONATE_URL, TK } from '@/config/site';

const uses = [
  {
    amount: '$20,000',
    text: 'Materials, tools, and Guild repair days at Saint Mary of Victories.',
  },
  { amount: '$20,000', text: 'Urgent medical care for two underinsured tradesmen.' },
  {
    amount: '$15,000',
    text: 'Emergency home repairs for families in need.',
  },
  {
    amount: '$5,000',
    text: 'Career formation for youth and adults called to the trades.',
  },
];

const tiers = [
  {
    name: 'Master',
    amount: '$20,000 and up',
    benefits: [
      'Named, with a special intention, at our Masses and holy hours.',
      'A copy of Fr. Calloway’s Consecration to St. Joseph.',
      'A hand-crafted wooden crucifix and a customized rosary made by Guild members.',
      'One small repair under $600 at your home, and up to five hours of plumbing inspection or consultation, pro bono.',
      'A paid place at the annual retreat, and invitations to all public Guild events.',
    ],
  },
  {
    name: 'Foreman',
    amount: '$5,000 and up',
    benefits: [
      'Named, with a special intention, at our Masses and holy hours.',
      'A copy of Consecration to St. Joseph.',
      'A hand-crafted wooden key holder made by a Guild member.',
      'One small repair under $200 at your home, and up to two hours of plumbing inspection or consultation, pro bono.',
      'An invitation to the annual retreat, and to all public Guild events.',
    ],
  },
  {
    name: 'Journeyman',
    amount: '$1,000 and up',
    benefits: [
      'Named, with a special intention, at our Masses and holy hours.',
      'A copy of Consecration to St. Joseph.',
      'A hand-crafted wooden key holder made by a Guild member.',
      'Invitations to all public Guild events.',
    ],
  },
  {
    name: 'Apprentice',
    amount: '$500 and up',
    benefits: [
      'Named, with a special intention, at our Masses and holy hours.',
      'A copy of Consecration to St. Joseph.',
    ],
  },
  {
    name: 'Pre-apprentice',
    amount: '$25 and up',
    benefits: ['Named in the prayer intentions at our Masses and holy hours.'],
  },
];
const giveHref = DONATE_URL;
---

<BaseLayout
  title="Support the Guild"
  description="Ways to give to the St. Joseph the Worker Guild: what a gift funds, giving levels from $25 to $20,000, and how to give directly to Saint Mary of Victories."
>
  <PageHeader
    title="Support the Guild"
    lede="Members carry the Guild's ordinary costs. Donors carry the work that cannot wait: parish repairs, medical costs for underinsured tradesmen, and emergency work for families with no one else to call."
  >
    <div class="mt-8 flex flex-wrap items-center gap-x-8 gap-y-4">
      <Button href={giveHref} variant="inverse" size="lg">
        Give now
      </Button>
      <a
        href="#ways"
        class="font-sans font-semibold text-stone underline decoration-brass decoration-2 underline-offset-4"
      >
        See giving levels
      </a>
    </div>
  </PageHeader>

  <Section tone="stone" labelledby="uses-title">
    <div class="grid gap-10 lg:grid-cols-[2fr_3fr] lg:gap-16">
      <div>
        <h2 id="uses-title" class="text-h2">
          Where a Gift Goes
        </h2>
        <p class="mt-4 max-w-[44ch] leading-relaxed">
          The Guild's <Tk {...TK.fundingGoalPeriod} /> funding goal is $60,000, allocated in full to
          four lines. No overhead line.
        </p>
      </div>
      <dl class="border-t border-mortar">
        {uses.map((u) => (
          <div class="grid grid-cols-[6.5rem_1fr] gap-4 border-b border-mortar py-4 sm:grid-cols-[8rem_1fr] sm:gap-8">
            <dt class="font-serif text-[1.35rem] leading-tight">{u.amount}</dt>
            <dd class="leading-relaxed">{u.text}</dd>
          </div>
        ))}
        <div class="grid grid-cols-[6.5rem_1fr] gap-4 py-4 sm:grid-cols-[8rem_1fr] sm:gap-8">
          <dt class="font-serif text-[1.35rem] leading-tight">$60,000</dt>
          <dd class="font-sans font-semibold leading-relaxed">The full goal.</dd>
        </div>
      </dl>
    </div>
  </Section>

  <Section tone="paper" id="ways" labelledby="ways-title">
    <h2 id="ways-title" class="text-h2">
      Ways to Give
    </h2>
    <p class="mt-3 max-w-[60ch] leading-relaxed">
      Every donor is named in the prayer intentions at our holy hours, on request. Larger gifts
      carry the thanks of working men: things made by hand, and work done at your home.
    </p>
    <div class="mt-8 border-t border-mortar">
      {tiers.map((t) => (
        <div class="grid gap-3 border-b border-mortar py-6 md:grid-cols-[minmax(0,1fr)_minmax(0,2fr)] md:gap-10">
          <div>
            <h3 class="text-h3 md:text-[1.75rem]">{t.name}</h3>
            <p class="mt-1 font-sans text-[1.05rem] font-semibold text-brick">{t.amount}</p>
          </div>
          <ul class="flex flex-col gap-2 leading-relaxed">
            {t.benefits.map((b) => (
              <li class="border-l-2 border-brass pl-4">{b}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="stone" labelledby="how-title" id="donate-placeholder">
    <div class="grid gap-10 md:grid-cols-2 lg:gap-16">
      <div>
        <h2 id="how-title" class="text-h2">
          How to Give
        </h2>
        <div class="mt-5 border-l-4 border-brass bg-paper p-6 leading-relaxed">
          <p>
            While the Guild organizes and awaits its 501(c)(3) status, St. Mary of Victories
            Catholic Church has generously agreed to receive gifts for the benefit of the Guild and
            our work there. Please give through St. Mary of Victories.
          </p>
          <p class="mt-3 font-sans text-[0.95rem] text-ash">
            Note "St. Joseph the Worker Guild" with your gift so the parish directs it to the Guild.
          </p>
          <a
            href="https://www.zeffy.com/en-US/donation-form/6eafe8fc-b9f4-4014-a65c-7c529f9f994e"
            class="mt-5 inline-block bg-brick px-5 py-3 font-sans font-semibold text-paper no-underline hover:bg-kiln"
          >
            Give through St. Mary of Victories
          </a>
        </div>
        <div class="mt-5 flex flex-col gap-5 leading-relaxed">
          <div class="border-t-4 border-brass bg-paper p-6">
            {live ? (
              <GiveForm client:visible />
            ) : (
              <>
                <h3 class="text-h3">Online</h3>
                <p class="mt-2">
                  <Tk {...TK.onlineGiving} />
                </p>
              </>
            )}
          </div>
          <div class="border-t border-mortar pt-5">
            <h3 class="text-h3">By Check</h3>
            <p class="mt-2">
              Payable to St. Mary of Victories Catholic Church, with "St. Joseph the Worker Guild"
              on the memo line. Mail to 744 S Third St, St. Louis, MO 63102, or hand it to a Guild
              officer.
            </p>
          </div>
          <div class="border-t border-mortar pt-5">
            <h3 class="text-h3">In Person</h3>
            <p class="mt-2">Any Guild officer, at a holy hour, meeting, or event.</p>
          </div>
        </div>
      </div>
      <div>
        <h2 class="text-h2">By the Numbers</h2>
        <dl class="mt-5 border-t border-mortar font-sans">
          <div class="flex items-baseline justify-between gap-4 border-b border-mortar py-3">
            <dt>Members targeted by 2029</dt>
            <dd class="font-serif text-[1.35rem]">100</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-b border-mortar py-3">
            <dt>First funding goal</dt>
            <dd class="font-serif text-[1.35rem]">$60,000</dd>
          </div>
        </dl>
      </div>
    </div>
  </Section>

  <Section tone="charcoal" labelledby="partner-title" pad="tight">
    <div class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <div>
        <h2 id="partner-title" class="text-h3 md:text-[1.75rem]">
          Partner with the Guild
        </h2>
        <p class="mt-2 max-w-[52ch] font-sans text-stone/85">
          Parishes, schools, and shrines that need work. Suppliers who can discount materials.
          Sponsors for programs and events. Used tools and materials are always welcome in our shop.
        </p>
      </div>
      <Button href="/contact#partner" variant="inverse">
        Talk to us about partnering
      </Button>
    </div>
  </Section>
  <SponsorStrip tone="paper" heading="Sponsors and Partners Already with Us" />
</BaseLayout>
