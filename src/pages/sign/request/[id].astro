---
/**
 * The same signing page for a logged-in person, reached from the portal. Only
 * the hash of the emailed token is stored, so the portal cannot rebuild that
 * link; instead the session proves who they are, and the request must be
 * addressed to their own directory entry or sent to their own account.
 */
import SignPage from '@/components/sign/SignPage.astro';
import { getSignRequest, recordView } from '@/server/esign';
import type { APIContext } from 'astro';
import { clientIp } from '@/server/http';
import { canSignInPortal } from '@/server/agreement-rules';

export const prerender = false;

const session = Astro.locals.session;
const id = Astro.params.id ?? '';
if (!session)
  return Astro.redirect(`/login?next=${encodeURIComponent(`/sign/request/${id}`)}`, 302);

const uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
let row = uuid.test(id) ? await getSignRequest(id) : null;
if (row && !canSignInPortal(session, row)) row = null;
// The emailed link's expiry does not apply here; the session is the proof.
let state: 'open' | 'signed' | 'voided' | 'expired' | 'missing' = !row
  ? 'missing'
  : row.signedAt
    ? 'signed'
    : row.voidedAt
      ? 'voided'
      : 'open';
if (row && state === 'open') {
  row = await recordView(row, {
    actor: session.name,
    ip: clientIp(Astro as unknown as APIContext),
    userAgent: Astro.request.headers.get('user-agent'),
    meta: { via: 'portal' },
  });
}
---

<SignPage
  row={row}
  state={state}
  endpoint={`/api/sign/request/${id}`}
  pdfUrl={`/api/sign/requests/${id}/pdf`}
/>
