---
import SignPage from '@/components/sign/SignPage.astro';
import { findByToken } from '@/server/esign';
import { linkState } from '@/server/esign-core';

export const prerender = false;

const token = Astro.params.token ?? '';
const row = await findByToken(token);
const state: 'open' | 'signed' | 'voided' | 'expired' | 'missing' = row
  ? linkState(row)
  : 'missing';
// The first view is recorded by the page's script (see SignForm viewUrl), not on this GET,
// so email link scanners that prefetch the URL never show up as the signer.
---

<SignPage
  row={row}
  state={state}
  endpoint={`/api/sign/${token}`}
  pdfUrl={`/api/sign/${token}/pdf`}
  viewUrl={`/api/sign/${token}/view`}
/>
