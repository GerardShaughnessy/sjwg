---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import LoginForm from '@/components/auth/LoginForm';

export const prerender = false;
---

<BaseLayout
  title="Member log in"
  description="Log in to the St. Joseph the Worker Guild member portal."
  noindex
>
  <PageHeader
    title="Member log in"
    lede="For Guild members and officers. Members are invited by an officer; there is no sign-up form."
  />
  <div class="wrap py-12 md:py-16">
    <LoginForm client:load />
  </div>
</BaseLayout>
