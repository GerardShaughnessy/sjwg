---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Hero from '@/components/home/Hero.astro';
import WhatIsTheGuild from '@/components/home/WhatIsTheGuild.astro';
import Pillars from '@/components/home/Pillars.astro';
import FoundingStory from '@/components/home/FoundingStory.astro';
import MembersStrip from '@/components/home/MembersStrip.astro';
import HowToHelp from '@/components/home/HowToHelp.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import EventsPreview from '@/components/home/EventsPreview.astro';
import BlogPreview from '@/components/home/BlogPreview.astro';
import WhereWeMeet from '@/components/home/WhereWeMeet.astro';
---

<BaseLayout>
  <Hero />
  <WhatIsTheGuild />
  <Pillars />
  <FoundingStory />
  <MembersStrip />
  <HowToHelp />
  <Testimonials />
  <Section tone="paper" labelledby="events-title">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <EventsPreview />
      <BlogPreview />
    </div>
  </Section>
  <WhereWeMeet />
</BaseLayout>
