---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Section from '@/components/ui/Section.astro';
import Hero from '@/components/home/Hero.astro';
import ModernChallenges from '@/components/home/ModernChallenges.astro';
import ConcreteResults from '@/components/home/ConcreteResults.astro';
import ThreeSteps from '@/components/home/ThreeSteps.astro';
import Pillars from '@/components/home/Pillars.astro';
import FoundingStory from '@/components/home/FoundingStory.astro';
import MembersStrip from '@/components/home/MembersStrip.astro';
import HowToHelp from '@/components/home/HowToHelp.astro';
import Testimonials from '@/components/home/Testimonials.astro';
import EventsPreview from '@/components/home/EventsPreview.astro';
import BlogPreview from '@/components/home/BlogPreview.astro';
import WhereWeMeet from '@/components/home/WhereWeMeet.astro';
import SponsorStrip from '@/components/home/SponsorStrip.astro';
import UnionNote from '@/components/home/UnionNote.astro';
---

<BaseLayout>
  <Hero />
  <ModernChallenges />
  <Pillars />
  <FoundingStory />
  <Testimonials />
  <ConcreteResults />
  <ThreeSteps />
  <HowToHelp />
  <UnionNote />
  <MembersStrip />
  <Section tone="stone" labelledby="events-title">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <EventsPreview />
      <BlogPreview />
    </div>
  </Section>
  <SponsorStrip tone="paper" />
  <WhereWeMeet />
</BaseLayout>
