---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Picture from '@/components/ui/Picture.astro';
import Tk from '@/components/ui/Tk.astro';
import InquiryForm from '@/components/forms/InquiryForm';
import { TK } from '@/config/site';
---

<BaseLayout
  title="Get Involved"
  description="Volunteer on a St. Joseph the Worker Guild repair crew, list your trade in the directory, mentor a young tradesman, or partner with the Guild."
>
  <PageHeader
    title="Get Involved"
    lede="Volunteer on a repair crew, list your trade, mentor a young tradesman, or partner with the Guild."
  />

  <Section tone="stone" labelledby="join-title">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <h2 id="join-title" class="text-h2">
          Volunteer With the Guild
        </h2>
        <div class="mt-5 flex max-w-[52ch] flex-col gap-4 leading-relaxed">
          <p>
            Our repair crews and parish work days are made up of Catholic volunteers, men and
            women, tradesmen and not. Plumbers, electricians, carpenters, roofers, masons,
            painters, HVAC, welders, and the trades between, and plenty of work for anyone who can
            haul, clean up, or cook for a crew.
          </p>
          <p class="font-semibold">What volunteering asks:</p>
          <ul class="flex flex-col gap-2">
            <li class="border-l-2 border-brass pl-4">
              Sign the Volunteer Covenant and follow the code of conduct.
            </li>
            <li class="border-l-2 border-brass pl-4">
              A short orientation, and any safety training the work calls for.
            </li>
            <li class="border-l-2 border-brass pl-4">
              18 or older. Young people of 16 and 17 serve alongside adults, with a parent's
              consent.
            </li>
            <li class="border-l-2 border-brass pl-4">
              Crew leads, and anyone who visits a home alone, are practicing Catholics.
            </li>
          </ul>
          <p>
            There are no dues and no fees. We hope each volunteer gives about 16 hours a year, but
            any time you can give is welcome.
          </p>
        </div>

        <div class="mt-10 flex max-w-[52ch] flex-col gap-4 leading-relaxed">
          <h3 class="text-h3">List Your Trade in the Directory</h3>
          <p>
            Our public directory connects Catholic families with practicing Catholic tradesmen who
            have signed the Guild's Ethical Standards. To be listed, a tradesman signs our listing
            agreement, shows proof of insurance and any license his or her trade requires, and
            commits to serve the Guild's charity work: at least two repair jobs a year, or
            mentoring an apprentice. Listing is free. There is no ranking and no paid placement.
          </p>
        </div>

        <div class="mt-10 flex max-w-[52ch] flex-col gap-4 leading-relaxed">
          <h3 class="text-h3">Thinking About the Trades?</h3>
          <p>
            Not a tradesman yet? The Guild offers come-and-see visits and mentoring for young men
            and women, and their families, discerning the trades. Say so in the note.
          </p>
        </div>
        <div class="mt-8">
          <Picture slot="carpenter" sizes="(min-width: 64rem) 45vw, 100vw" aspect="3 / 2" />
        </div>
      </div>
      <div class="border-t-4 border-brass bg-paper p-6 md:p-10">
        <h3 class="text-h3">Ask About Volunteering</h3>
        <p class="mt-2 max-w-[48ch] font-sans text-[0.95rem] text-ash">
          <Tk {...TK.whoReplies} />
        </p>
        <div class="mt-6">
          <InquiryForm
            client:visible
            kind="membership"
            submitLabel="Send"
            phoneOrEmail
            successTitle="Got it. Someone from the Guild will be in touch."
            fields={[
              { id: 'name', label: 'Your name', required: true, autoComplete: 'name' },
              {
                id: 'trade',
                label: 'Your trade or skills',
                required: true,
                hint: 'Or "none", or "discerning" if you are looking at the trades.',
              },
              {
                id: 'status',
                label: 'What interests you',
                type: 'select',
                optional: true,
                options: [
                  'I want to volunteer on a crew',
                  'I want to list my trade in the directory',
                  'I want to mentor a young tradesman',
                  'I am discerning the trades',
                  'Something else',
                ],
              },
              {
                id: 'business',
                label: 'Shop or business name',
                optional: true,
                autoComplete: 'organization',
              },
              {
                id: 'phone',
                label: 'Phone',
                type: 'tel',
                autoComplete: 'tel',
                hint: 'Phone or email, whichever you check.',
              },
              { id: 'email', label: 'Email', type: 'email', autoComplete: 'email' },
              { id: 'parish', label: 'Your parish', optional: true },
              {
                id: 'note',
                label: 'Anything you want us to know',
                type: 'textarea',
                optional: true,
              },
            ]}
          >
            <p slot="successBody">
              <Tk {...TK.whoReplies} />
            </p>
          </InquiryForm>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="paper" labelledby="other-title">
    <h2 id="other-title" class="text-h2">
      Other Ways In
    </h2>
    <div class="mt-8 grid gap-8 border-t border-mortar pt-8 md:grid-cols-3">
      <div>
        <h3 class="text-h3">Volunteer</h3>
        <p class="mt-3 leading-relaxed">
          Beyond repair crews: hauling, cleanup, food, and setup for the procession and the
          Christmas party. See{' '}
          <a href="/events" class="underline decoration-brass decoration-2 underline-offset-4">
            events
          </a>
          .
        </p>
        <div class="mt-4">
          <Button href="/contact" variant="quiet">
            Ask about volunteering
          </Button>
        </div>
      </div>
      <div>
        <h3 class="text-h3">Partner</h3>
        <p class="mt-3 leading-relaxed">
          Parishes, schools, and shrines that need work. Suppliers who can discount materials.
          Sponsors for programs and events. Used tools and materials are always welcome in our shop.
        </p>
        <div class="mt-4">
          <Button href="/contact#partner" variant="quiet">
            Partner with the Guild
          </Button>
        </div>
      </div>
      <div>
        <h3 class="text-h3">Hire a Listed Tradesman</h3>
        <p class="mt-3 leading-relaxed">
          Browse Catholic tradesmen who have signed our Ethical Standards. You hire them directly,
          at their ordinary rates; the Guild doesn't employ or guarantee them.
        </p>
        <div class="mt-4">
          <Button href="/directory" variant="quiet">
            Browse the directory
          </Button>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
