---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Picture from '@/components/ui/Picture.astro';
import Tk from '@/components/ui/Tk.astro';
import InquiryForm from '@/components/forms/InquiryForm';
import { TK } from '@/config/site';
---

<BaseLayout
  title="Get Involved"
  description="List your trade in the St. Joseph the Worker Guild directory, mentor a young tradesman, or partner with the Guild."
>
  <PageHeader
    title="Get Involved"
    lede="List your trade, mentor a young tradesman, or partner with the Guild."
  />

  <Section tone="stone" labelledby="join-title">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <h2 id="join-title" class="text-h2">
          List Your Trade in the Directory
        </h2>
        <div class="mt-5 flex max-w-[52ch] flex-col gap-4 leading-relaxed">
          <p>
            Our directory helps Catholic families, parishes, and institutions find practising
            Catholic tradesmen who share their values. Listing is free. There is no ranking, no paid
            placement, and no fee or commission either way.
          </p>
          <p class="font-semibold">To be listed, a tradesman:</p>
          <ul class="flex flex-col gap-2">
            <li class="border-l-2 border-brass pl-4">
              Is a baptized, confirmed, and practising Catholic, with proof of baptism and
              confirmation.
            </li>
            <li class="border-l-2 border-brass pl-4">
              Takes the Guild's{' '}
              <a
                href="/documents/ethical-pledge"
                class="underline decoration-brass decoration-2 underline-offset-4"
              >
                Ethical Pledge
              </a>{' '}
              and signs the listing agreement and waiver, all online.
            </li>
            <li class="border-l-2 border-brass pl-4">
              Shows proof of insurance and any license the trade requires. Tradeswomen are welcome.
            </li>
          </ul>
          <p>
            Listed tradesmen are independent. The Guild does not employ, supervise, or guarantee
            them. We hope each will consider taking on charity work for those in need, free or
            discounted, when the Guild asks, but it is never required.
          </p>
        </div>

        <div class="mt-10 flex max-w-[52ch] flex-col gap-4 leading-relaxed">
          <h3 class="text-h3">Thinking About the Trades?</h3>
          <p>
            Not a tradesman yet? The Guild offers come-and-see visits and mentoring for young men
            and women, and their families, discerning the trades. Say so in the note.
          </p>
        </div>
        <div class="mt-8">
          <Picture slot="carpenter" sizes="(min-width: 64rem) 45vw, 100vw" aspect="3 / 2" />
        </div>
      </div>
      <div class="border-t-4 border-brass bg-paper p-6 md:p-10">
        <h3 class="text-h3">Ask About Listing</h3>
        <p class="mt-2 max-w-[48ch] font-sans text-[0.95rem] text-ash">
          <Tk {...TK.whoReplies} />
        </p>
        <div class="mt-6">
          <InquiryForm
            client:visible
            kind="membership"
            submitLabel="Send"
            phoneOrEmail
            successTitle="Got it. Someone from the Guild will be in touch."
            fields={[
              { id: 'name', label: 'Your name', required: true, autoComplete: 'name' },
              {
                id: 'trade',
                label: 'Your trade or skills',
                required: true,
                hint: 'Or "none", or "discerning" if you are looking at the trades.',
              },
              {
                id: 'status',
                label: 'What interests you',
                type: 'select',
                optional: true,
                options: [
                  'I want to list my trade in the directory',
                  'I am open to charity work when the Guild asks',
                  'I want to mentor a young tradesman',
                  'I am discerning the trades',
                  'Something else',
                ],
              },
              {
                id: 'business',
                label: 'Shop or business name',
                optional: true,
                autoComplete: 'organization',
              },
              {
                id: 'phone',
                label: 'Phone',
                type: 'tel',
                autoComplete: 'tel',
                hint: 'Phone or email, whichever you check.',
              },
              { id: 'email', label: 'Email', type: 'email', autoComplete: 'email' },
              { id: 'parish', label: 'Your parish', optional: true },
              {
                id: 'note',
                label: 'Anything you want us to know',
                type: 'textarea',
                optional: true,
              },
            ]}
          >
            <p slot="successBody">
              <Tk {...TK.whoReplies} />
            </p>
          </InquiryForm>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="paper" labelledby="other-title">
    <h2 id="other-title" class="text-h2">
      Other Ways In
    </h2>
    <div class="mt-8 grid gap-8 border-t border-mortar pt-8 md:grid-cols-3">
      <div>
        <h3 class="text-h3">Need Help?</h3>
        <p class="mt-3 leading-relaxed">
          Families, parishes, schools, and Catholic institutions facing a need they cannot afford
          can apply for financial assistance. Funds are limited, and each request is reviewed case
          by case.
        </p>
        <div class="mt-4">
          <Button href="/request" variant="quiet">
            Request help
          </Button>
        </div>
      </div>
      <div>
        <h3 class="text-h3">Partner</h3>
        <p class="mt-3 leading-relaxed">
          Suppliers who can discount materials. Sponsors for programs and events. Parishes and
          schools that want to share the directory with their families.
        </p>
        <div class="mt-4">
          <Button href="/contact#partner" variant="quiet">
            Partner with the Guild
          </Button>
        </div>
      </div>
      <div>
        <h3 class="text-h3">Find a Listed Tradesman</h3>
        <p class="mt-3 leading-relaxed">
          Browse practising Catholic tradesmen who have taken our Ethical Pledge. You hire them
          directly; the Guild doesn't employ or guarantee them.
        </p>
        <div class="mt-4">
          <Button href="/directory" variant="quiet">
            Browse the directory
          </Button>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
