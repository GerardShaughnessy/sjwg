---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Button from '@/components/ui/Button.astro';
import Picture from '@/components/ui/Picture.astro';
import Tk from '@/components/ui/Tk.astro';
import InquiryForm from '@/components/forms/InquiryForm';
import { TK } from '@/config/site';
---

<BaseLayout
  title="Get Involved"
  description="Join the St. Joseph the Worker Guild as a tradesman, volunteer at a parish work day, partner with the Guild, or hire a member."
>
  <PageHeader
    title="Get Involved"
    lede="For tradesmen who want brothers, for neighbors who want to help, and for organizations that want to work with the Guild."
  />

  <Section tone="stone" labelledby="join-title">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <h2 id="join-title" class="text-h2">
          Join as a Tradesman
        </h2>
        <div class="mt-5 flex max-w-[52ch] flex-col gap-4 leading-relaxed">
          <p>
            Membership is for practicing Catholic men, 16 and older, working in the skilled trades
            or retired from them. Union or independent, owner or employee, full time or part time.
            Plumbers, electricians, carpenters, roofers, masons, painters, HVAC, welders, mechanics,
            and the trades between.
          </p>
          <h3 class="mt-4 text-h3">What a Brother Receives</h3>
          <p>
            Guild Masses, holy hours, and retreats. Business-ethics formation and mentorship. The
            tool library and shop space. A listing in the public directory. Referrals from men who
            know your work. And a brotherhood that shows up when your family faces an emergency.
          </p>
          <p class="font-semibold">What membership asks:</p>
          <ul class="flex flex-col gap-2">
            <li class="border-l-2 border-brass pl-4">
              Sign the membership pledge and the Guild's ethical standards.
            </li>
            <li class="border-l-2 border-brass pl-4">
              16 hours of designated charity work a year: parish work days and repairs for people in
              need.
            </li>
            <li class="border-l-2 border-brass pl-4">
              Six of the twelve monthly meetings, Masses, or holy hours.
            </li>
            <li class="border-l-2 border-brass pl-4">
              Dues by tier, below. Hardship is handled case by case with an officer.
            </li>
            <li class="border-l-2 border-brass pl-4">
              From 2027, a sponsor from among current members.
            </li>
          </ul>
        </div>

        <h3 class="mt-10 text-h3">Membership Tiers</h3>
        <dl class="mt-4 grid max-w-[60ch] border-t border-mortar font-sans">
          {[
            {
              name: 'Active Brother',
              dues: '$25 a month, or $250 a year',
              who: 'A year or more in the trades, as owner, employee, or self-employed. Owners carry general liability insurance.',
            },
            {
              name: 'Inactive Brother',
              dues: '$25 a month, or $250 a year',
              who: 'Part-time tradesmen, and members not yet meeting every requirement.',
            },
            {
              name: 'Guild Builder',
              dues: '$500 to $1,500 a year',
              who: 'Owners of trade businesses with $250,000 or more in adjusted gross income. Six service hours and three meetings a year.',
            },
            {
              name: 'Faithful Brother',
              dues: '$12 a month, or $100 a year',
              who: 'Supporters of the mission, retired tradesmen, and Sons of the Guild (16 and 17, with a parent’s consent).',
            },
          ].map((t) => (
            <div class="grid gap-1 border-b border-mortar py-4 sm:grid-cols-[11rem_1fr] sm:gap-6">
              <dt class="font-semibold">{t.name}</dt>
              <dd>
                <span class="block font-semibold text-brick">{t.dues}</span>
                <span class="mt-1 block text-[0.95rem] leading-relaxed text-ash">{t.who}</span>
              </dd>
            </div>
          ))}
        </dl>

        <div class="mt-8 flex max-w-[52ch] flex-col gap-4 leading-relaxed">
          <h3 class="text-h3">Thinking About the Trades?</h3>
          <p>
            Not a tradesman yet? The Guild runs come-and-see visits for men and families discerning
            the trades. Say so in the note.
          </p>
        </div>
        <div class="mt-8">
          <Picture slot="carpenter" sizes="(min-width: 64rem) 45vw, 100vw" aspect="3 / 2" />
        </div>
      </div>
      <div class="border-t-4 border-brass bg-paper p-6 md:p-10">
        <h3 class="text-h3">Ask About Membership</h3>
        <p class="mt-2 max-w-[48ch] font-sans text-[0.95rem] text-ash">
          <Tk {...TK.whoReplies} />
        </p>
        <div class="mt-6">
          <InquiryForm
            client:visible
            kind="membership"
            submitLabel="Send"
            phoneOrEmail
            successTitle="Got it. A member will be in touch."
            fields={[
              { id: 'name', label: 'Your name', required: true, autoComplete: 'name' },
              {
                id: 'trade',
                label: 'Your trade',
                required: true,
                hint: 'Or "discerning" if you are looking at the trades.',
              },
              {
                id: 'status',
                label: 'Which describes you',
                type: 'select',
                optional: true,
                options: [
                  'I own a shop or work for myself',
                  'I work for a trade company',
                  'Part time in the trades',
                  'Retired from the trades',
                  'Discerning the trades',
                  'Supporter of the mission',
                ],
              },
              {
                id: 'business',
                label: 'Shop or business name',
                optional: true,
                autoComplete: 'organization',
              },
              {
                id: 'phone',
                label: 'Phone',
                type: 'tel',
                autoComplete: 'tel',
                hint: 'Phone or email, whichever you check.',
              },
              { id: 'email', label: 'Email', type: 'email', autoComplete: 'email' },
              { id: 'parish', label: 'Your parish', optional: true },
              {
                id: 'note',
                label: 'Anything you want us to know',
                type: 'textarea',
                optional: true,
              },
            ]}
          >
            <p slot="successBody">
              <Tk {...TK.whoReplies} />
            </p>
          </InquiryForm>
        </div>
      </div>
    </div>
  </Section>

  <Section tone="paper" labelledby="other-title">
    <h2 id="other-title" class="text-h2">
      Other Ways In
    </h2>
    <div class="mt-8 grid gap-8 border-t border-mortar pt-8 md:grid-cols-3">
      <div>
        <h3 class="text-h3">Volunteer</h3>
        <p class="mt-3 leading-relaxed">
          Work days need more than tradesmen: hauling, cleanup, food, and setup for the procession
          and the Christmas party. See{' '}
          <a href="/events" class="underline decoration-brass decoration-2 underline-offset-4">
            events
          </a>
          .
        </p>
        <div class="mt-4">
          <Button href="/contact" variant="quiet">
            Ask about volunteering
          </Button>
        </div>
      </div>
      <div>
        <h3 class="text-h3">Partner</h3>
        <p class="mt-3 leading-relaxed">
          Parishes, schools, and shrines that need work. Suppliers who can discount materials.
          Sponsors for programs and events. Used tools and materials are always welcome in our shop.
        </p>
        <div class="mt-4">
          <Button href="/contact#partner" variant="quiet">
            Partner with the Guild
          </Button>
        </div>
      </div>
      <div>
        <h3 class="text-h3">Hire a Member</h3>
        <p class="mt-3 leading-relaxed">
          The simplest way to support a Guild tradesman is to hire him at his ordinary rate. Every
          job supports a local family.
        </p>
        <div class="mt-4">
          <Button href="/directory" variant="quiet">
            Browse the directory
          </Button>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
