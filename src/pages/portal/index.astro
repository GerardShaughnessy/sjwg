---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import PortalApp from '@/components/portal/PortalApp';
import { getAreas } from '@/lib/trades';

export const prerender = false;

// The middleware already redirected anyone without a session to /login.
const session = Astro.locals.session;
if (!session) return Astro.redirect('/login?next=/portal', 302);

const members = (await getCollection('members')).map((m) => m.data);
const events = (await getCollection('events')).map((e) => e.data);
const areas = getAreas(members);
---

<BaseLayout
  title="Member portal"
  description="Job board, calendar, directory entry, blog drafts, and donor records for Guild members."
  noindex
  suppressWelcome
>
  <PageHeader title="Member portal" lede={`Logged in as ${session.name}.`} />
  <div class="wrap py-10 md:py-14">
    <PortalApp client:load session={session} members={members} events={events} areas={areas}>
      <div slot="fallback" aria-busy="true">
        <p class="font-sans text-ash">Loading the portal.</p>
        <noscript>
          <p class="mt-3">The member portal needs JavaScript.</p>
        </noscript>
      </div>
    </PortalApp>
  </div>
</BaseLayout>
