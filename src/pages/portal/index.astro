---
import '@fontsource-variable/archivo';
import '@fontsource/libre-caslon-text/400.css';
import '@fontsource/libre-caslon-text/400-italic.css';
import '@fontsource/libre-caslon-text/700.css';
import '@/styles/global.css';
import { getCollection } from 'astro:content';
import SeoHead from '@/components/site/SeoHead.astro';
import SkipLink from '@/components/site/SkipLink.astro';
import PortalApp from '@/components/portal/PortalApp';
import { getAreas } from '@/lib/trades';
import { portalNameFor } from '@/server/auth/session';

export const prerender = false;

// The middleware already redirected anyone without a session to /login.
const session = Astro.locals.session;
if (!session) return Astro.redirect('/login?next=/portal', 302);

// Members are read only for the service-area list; the island never gets them.
const members = (await getCollection('members')).map((m) => m.data);
const events = (await getCollection('events')).map((e) => e.data);
const areas = getAreas(members);
---

<!--
  The portal has its own header and sidebar (the approved portal design), so
  it does not use the public site's navigation and footer. The seal links home.
-->
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#43402a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <SeoHead
      title={`${portalNameFor(session)} portal`}
      description="Directory entry, paperwork, calendar, and Guild work for listed tradesmen and Guild officers."
      noindex
    />
  </head>
  <body class="bg-stone min-h-svh">
    <SkipLink />
    <PortalApp client:load session={session} events={events} areas={areas}>
      <div slot="fallback" aria-busy="true" class="p-6">
        <p class="font-sans text-ash">Loading the portal.</p>
        <noscript>
          <p class="mt-3">The portal needs JavaScript.</p>
        </noscript>
      </div>
    </PortalApp>
  </body>
</html>
