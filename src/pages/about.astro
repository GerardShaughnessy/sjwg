---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Picture from '@/components/ui/Picture.astro';
import WhatIsTheGuild from '@/components/home/WhatIsTheGuild.astro';
import Button from '@/components/ui/Button.astro';

const values = [
  {
    term: 'Steadfast Endurance',
    text: 'We work diligently, follow through on our commitments, and pursue excellence in everything entrusted to us. (2 Peter 1:6)',
  },
  {
    term: 'Humble Service',
    text: 'We lead and contribute with humility, putting our talents to work for the benefit of others.',
  },
  {
    term: 'Faithful Integrity',
    text: 'We act honestly and transparently, ensuring our words, decisions, and conduct remain faithful to Catholic teaching.',
  },
  {
    term: 'Proactive Ownership',
    text: 'We approach obstacles with resourcefulness, personal responsibility, and a determination to move forward.',
  },
];

const programs = [
  {
    name: 'Spiritual Growth',
    items: [
      'Consecration to St. Joseph the Worker and St. Louis IX as patrons.',
      'Monthly tradesmen-focused Holy Hours, adoration, and spiritual direction.',
      'An annual tradesmen’s retreat.',
      'The annual St. Joseph the Worker Holy Day procession.',
    ],
  },
  {
    name: 'Business Networking and Fraternity',
    items: [
      'A member directory for referrals and a public directory of vetted Catholic tradesmen.',
      'A monthly newsletter, and pricing advocacy that accounts for local costs of living, for clients, employees, and owners alike.',
      'Monthly formation meetings to foster Catholic business ethics and strengthen bonds between members.',
    ],
  },
  {
    name: 'Corporal Works of Mercy',
    items: [
      'Discounted and pro bono work for families, parishes, schools, and shrines in need.',
      'Emergency response: storm cleanup, tarping, and manual labor.',
      'Every member gives at least 16 hours, two service days, of designated charity work a year.',
    ],
  },
  {
    name: 'Education and Opportunity',
    items: [
      'Career guidance and enrichment courses for members, and introductory classes for Catholic homeowners.',
      'Come-and-see visits and career consultation for families and prospective members discerning a future in the trades.',
    ],
  },
  {
    name: 'Practical Resources',
    items: [
      'A shared workshop and tool library, stocked and maintained by member donations, so no tradesman has to buy alone what the Guild can provide together. The library is also used to discount material costs for work serving disadvantaged clients.',
      'Healthcare cost advocacy for underinsured tradesmen, and a community that rallies around any tradesman and his family facing a hard season.',
    ],
  },
];
---

<BaseLayout
  title="About the Guild"
  description="Who the St. Joseph the Worker Guild is, what a Catholic guild is, its five pillars of work, its values, and where it is headed."
>
  <PageHeader
    title="About the Guild"
    lede="A Catholic fraternal organization for tradesmen, based at Saint Mary of Victories in St. Louis. Consecrated to St. Joseph the Worker and St. Louis IX."
  />

  <Section tone="stone" labelledby="def-title">
    <div class="grid gap-10 lg:grid-cols-[3fr_2fr] lg:gap-16">
      <div class="measure flex flex-col gap-5 leading-relaxed">
        <h2 id="def-title" class="text-h2">
          Who We Are
        </h2>
        <dl class="mt-2 grid gap-4 border-t border-mortar pt-5 sm:grid-cols-[auto_1fr] sm:gap-x-8">
          <dt class="font-sans font-semibold">Mission Statement</dt>
          <dd>We exist to build a brotherhood where Catholic tradesmen can flourish.</dd>
          <dt class="font-sans font-semibold">Niche</dt>
          <dd>
            We unite our members through mutual assistance, spiritual formation, networking, and
            practical resources.
          </dd>
          <dt class="font-sans font-semibold">Who</dt>
          <dd>Devout Catholic men working in, or retired from, the skilled trades.</dd>
        </dl>
      </div>
      <div class="flex flex-col gap-6">
        <Picture slot="spiritual" sizes="(min-width: 64rem) 35vw, 100vw" aspect="4 / 5" />
        <blockquote class="border-l-4 border-brass pl-5 font-serif italic leading-relaxed">
          <p>
            “We greatly wish, for the salvation of the people, that these guilds may be generally
            restored. To help the honest workman, to protect and guard his children and family, and
            to promote in them piety, Christian knowledge, and a moral life.”
          </p>
          <footer class="mt-2 font-sans text-[0.9rem] not-italic text-ash">
            Pope Leo XIII, Humanum Genus, 1884
          </footer>
        </blockquote>
      </div>
    </div>
  </Section>

  <WhatIsTheGuild tone="paper" />

  <Section tone="stone" labelledby="programs-title">
    <h2 id="programs-title" class="text-h2">
      Our 5 Pillars of Works
    </h2>
    <p class="mt-3 max-w-[60ch] leading-relaxed">
      Five areas of work. Spiritual growth comes first because everything else depends on it.
    </p>
    <div class="mt-8 grid gap-x-12 gap-y-10 border-t border-mortar pt-8 md:grid-cols-2">
      {programs.map((p) => (
        <div>
          <h3 class="text-h3">{p.name}</h3>
          <ul class="mt-3 flex flex-col gap-2 leading-relaxed">
            {p.items.map((i) => (
              <li class="border-l-2 border-brass pl-4">{i}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <Section tone="paper" labelledby="values-title">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <h2 id="values-title" class="text-h2">
          Our Values
        </h2>
        <dl class="mt-6 border-t border-mortar">
          {values.map((v) => (
            <div class="border-b border-mortar py-4">
              <dt class="font-serif text-h3">{v.term}</dt>
              <dd class="mt-1 leading-relaxed">{v.text}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="text-h2">Where We Are Headed</h2>
        <dl class="mt-6 border-t border-mortar">
          <div class="border-b border-mortar py-4">
            <dt class="font-sans font-semibold">This Year</dt>
            <dd class="mt-1 leading-relaxed">
              Build the founding board, welcome the first 60 dues-paying members, stand up the
              referral and networking system members have been asking for, hold the St. Joseph the
              Worker Procession, secure regular tradesmen's Masses, confession, and holy hours, and
              build an emergency assistance fund for tradesmen and families in crisis, ready by
              2028.
            </dd>
          </div>
          <div class="border-b border-mortar py-4">
            <dt class="font-sans font-semibold">2029 Goals</dt>
            <dd class="mt-1 leading-relaxed">
              100 active members, monthly Mass and Holy Hour, an annual overnight retreat, an
              established tradesmen education partnership, a wide-ranging referral directory with a
              surplus of tradesmen to choose from, healthcare cost advocacy for tradesmen, and a
              governing board of five to seven.
            </dd>
          </div>
          <div class="border-b border-mortar py-4">
            <dt class="font-sans font-semibold">2031 Target</dt>
            <dd class="mt-1 leading-relaxed">
              250 well-formed tradesmen serving our community, with a 75% retention rate.
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </Section>

  <Section tone="charcoal" labelledby="join-title">
    <div class="measure flex flex-col gap-5 font-serif text-[1.2rem] leading-[1.65]">
      <h2 id="join-title" class="text-h2 font-sans">
        Join Us
      </h2>
      <p>
        There is a fallen plaque in the ancient corridors of the Catholic Church. A plaque lying
        dusty, trampled, and forgotten. It was forged over centuries by the hands of thousands of
        devout workmen. Upon it, the words still faintly glimmer: Tradesman's Guild.
      </p>
      <p>
        A guild that sees man not merely as an economic unit, but as body and soul, created in the
        image of God. A guild that sees labor and family not as competitors, but as intimately bound
        together. A guild that sees work not as a means to grow rich, but as a calling to grow holy.
      </p>
      <p>
        Will you join us in breathing new life into the Catholic guild tradition, and restoring
        Christ to His rightful place in our work, our communities, and our families?
      </p>
      <div class="mt-4 flex flex-wrap gap-4 font-sans text-[1rem]">
        <Button href="/get-involved" variant="inverse">
          Get Involved
        </Button>
        <Button href="/donate" variant="quiet" class="text-stone">
          Support the Guild
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
