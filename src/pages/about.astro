---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Section from '@/components/ui/Section.astro';
import Picture from '@/components/ui/Picture.astro';
import WhatIsTheGuild from '@/components/home/WhatIsTheGuild.astro';
import Button from '@/components/ui/Button.astro';

const values = [
  {
    term: 'Steadfast Endurance',
    text: 'We work diligently, follow through, and pursue excellence in everything entrusted to us. (2 Peter 1:6)',
  },
  {
    term: 'Humble Service',
    text: 'We lead and contribute with humility, putting our talents to work for others.',
  },
  {
    term: 'Faithful Integrity',
    text: 'We act honestly and transparently, faithful to Catholic teaching in word, decision, and conduct.',
  },
  {
    term: 'Proactive Ownership',
    text: 'We meet obstacles with resourcefulness, personal responsibility, and a determination to move forward.',
  },
];

const programs = [
  {
    name: 'Spiritual Growth',
    items: [
      'Consecration to St. Joseph the Worker and St. Louis IX.',
      'Monthly holy hours, adoration, and spiritual direction for tradesmen.',
      'An annual retreat and the St. Joseph the Worker procession each May.',
    ],
  },
  {
    name: 'Networking and Fraternity',
    items: [
      'A member directory for referrals and a public directory of Guild tradesmen.',
      'Monthly formation meetings in Catholic business ethics, and a monthly newsletter.',
    ],
  },
  {
    name: 'Corporal Works of Mercy',
    items: [
      'Discounted and pro bono work for families, parishes, schools, and shrines in need.',
      'Emergency response: storm cleanup, tarping, and manual labor.',
      'Every member gives at least 16 hours of designated charity work a year.',
    ],
  },
  {
    name: 'Education and Opportunity',
    items: [
      'Career guidance and enrichment courses for members; introductory classes for Catholic homeowners.',
      'Come-and-see visits for men and families discerning a future in the trades.',
    ],
  },
  {
    name: 'Practical Resources',
    items: [
      'A shared workshop and tool library, stocked by member donations, which also discounts materials for work serving the poor.',
      'Help navigating healthcare costs, and a community that rallies around any tradesman facing a hard season.',
    ],
  },
];
---

<BaseLayout
  title="About the Guild"
  description="Who the St. Joseph the Worker Guild is, what a Catholic guild is, its five pillars of work, its values, and where it is headed."
>
  <PageHeader
    title="About the Guild"
    lede="A Catholic fraternal organization for tradesmen at Saint Mary of Victories in St. Louis, consecrated to St. Joseph the Worker and St. Louis IX."
  />

  <Section tone="stone" labelledby="def-title">
    <div class="grid gap-10 lg:grid-cols-[3fr_2fr] lg:gap-16">
      <div class="measure flex flex-col gap-5 leading-relaxed">
        <h2 id="def-title" class="text-h2">
          Who We Are
        </h2>
        <dl class="mt-2 grid gap-4 border-t border-mortar pt-5 sm:grid-cols-[auto_1fr] sm:gap-x-8">
          <dt class="font-sans font-semibold">Mission Statement</dt>
          <dd>We exist to build a brotherhood where Catholic tradesmen can flourish.</dd>
          <dt class="font-sans font-semibold">Niche</dt>
          <dd>
            We unite our members through mutual assistance, spiritual formation, networking, and
            practical resources.
          </dd>
          <dt class="font-sans font-semibold">Who</dt>
          <dd>Devout Catholic men working in, or retired from, the skilled trades.</dd>
        </dl>
      </div>
      <div class="flex flex-col gap-6">
        <Picture slot="spiritual" sizes="(min-width: 64rem) 35vw, 100vw" aspect="4 / 5" />
        <blockquote class="border-l-4 border-brass pl-5 font-serif italic leading-relaxed">
          <p>
            “We greatly wish, for the salvation of the people, that these guilds may be generally
            restored. To help the honest workman, to protect and guard his children and family, and
            to promote in them piety, Christian knowledge, and a moral life.”
          </p>
          <footer class="mt-2 font-sans text-[0.9rem] not-italic text-ash">
            Pope Leo XIII, Humanum Genus, 1884
          </footer>
        </blockquote>
      </div>
    </div>
  </Section>

  <Section tone="paper" labelledby="programs-title">
    <h2 id="programs-title" class="text-h2">
      Our 5 Pillars of Works
    </h2>
    <p class="mt-3 max-w-[60ch] leading-relaxed">
      Spiritual growth comes first because everything else depends on it.
    </p>
    <div class="mt-8 grid gap-x-12 gap-y-10 border-t border-mortar pt-8 md:grid-cols-2">
      {programs.map((p) => (
        <div>
          <h3 class="text-h3">{p.name}</h3>
          <ul class="mt-3 flex flex-col gap-2 leading-relaxed">
            {p.items.map((i) => (
              <li class="border-l-2 border-brass pl-4">{i}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  <WhatIsTheGuild tone="stone" />

  <Section tone="paper" labelledby="values-title">
    <div class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16">
      <div>
        <h2 id="values-title" class="text-h2">
          Our Values
        </h2>
        <dl class="mt-6 border-t border-mortar">
          {values.map((v) => (
            <div class="border-b border-mortar py-4">
              <dt class="font-serif text-h3">{v.term}</dt>
              <dd class="mt-1 leading-relaxed">{v.text}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <h2 class="text-h2">Where We Are Headed</h2>
        <dl class="mt-6 border-t border-mortar">
          <div class="border-b border-mortar py-4">
            <dt class="font-sans font-semibold">This Year</dt>
            <dd class="mt-1 leading-relaxed">
              A founding board, the first 60 members, a working referral network, the St. Joseph the
              Worker procession, regular Masses and holy hours, and the start of an emergency fund.
            </dd>
          </div>
          <div class="border-b border-mortar py-4">
            <dt class="font-sans font-semibold">2029</dt>
            <dd class="mt-1 leading-relaxed">
              100 active members, monthly Mass and holy hour, an annual retreat, an education
              partnership, and a board of five to seven.
            </dd>
          </div>
          <div class="border-b border-mortar py-4">
            <dt class="font-sans font-semibold">2031</dt>
            <dd class="mt-1 leading-relaxed">250 well-formed tradesmen serving our community.</dd>
          </div>
        </dl>
      </div>
    </div>
  </Section>

  <Section tone="charcoal" labelledby="join-title">
    <div class="measure flex flex-col gap-5 font-serif text-[1.2rem] leading-[1.65]">
      <h2 id="join-title" class="text-h2 font-sans">
        Join Us
      </h2>
      <p>
        For centuries, Catholic guilds saw a workman not as an economic unit but as body and soul,
        made in the image of God. They saw labor and family not as rivals but as bound together, and
        work not as a way to get rich but as a way to grow holy.
      </p>
      <p>Will you help us bring that tradition back to life?</p>
      <div class="mt-4 flex flex-wrap gap-4 font-sans text-[1rem]">
        <Button href="/get-involved" variant="inverse">
          Get Involved
        </Button>
        <Button href="/donate" variant="quiet" class="text-stone">
          Support the Guild
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>
