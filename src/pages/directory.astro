---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Banner from '@/components/ui/Banner.astro';
import DirectoryExplorer from '@/components/members/DirectoryExplorer';
import { getTrades, getAreas } from '@/lib/trades';

const entries = await getCollection('members');
const members = entries.map((m) => m.data);
const allSample = members.length > 0 && members.every((m) => m.sample);
const trades = getTrades(members);
const areas = getAreas(members);
---

<BaseLayout
  title="Tradesman directory"
  description="Practicing Catholic tradesmen in the St. Louis area who have signed the St. Joseph the Worker Guild's Ethical Standards and serve its charity work, by trade and area served."
>
  <PageHeader
    title="Tradesman Directory"
    lede="Practicing Catholic tradesmen who have signed the Guild's Ethical Standards, shown proof of insurance and any license their trade requires, and serve on the Guild's charity jobs. Listings appear in random order."
  />
  <div class="wrap py-10 md:py-14">
    {allSample && (
      <Banner class="mb-8">
        <strong>Sample directory.</strong> These names are placeholders. Real tradesmen will be
        listed once each has signed the listing agreement and agreed to what appears publicly.
      </Banner>
    )}
    <p class="mb-8 max-w-[70ch] border-l-4 border-brass bg-paper p-5 font-sans text-[0.95rem] leading-relaxed">
      <strong>Please read:</strong> St. Joseph the Worker Guild does not employ, supervise, or
      guarantee the tradesmen listed here, and does not receive any fee or commission from them or
      from you. You hire a listed tradesman directly, and the price, the work, and responsibility
      for it are between you and the tradesman. Check licenses, insurance, and references as you
      would for anyone. Listing is free, and the order is random.
    </p>
    <DirectoryExplorer client:load members={members} trades={trades} areas={areas} />
    <p class="mt-10 max-w-[60ch] font-sans text-[0.95rem] leading-relaxed text-ash">
      Not sure which trade you need?{' '}
      <a href="/request?trade=not-sure" class="font-semibold text-charcoal">
        Describe the problem
      </a>{' '}
      and the Guild will figure out who should call you.
    </p>
    <p class="mt-4 max-w-[60ch] font-sans text-[0.85rem] leading-relaxed text-ash">
      Many of the tradesmen listed belong to, or work alongside, the local unions. If you already
      have a union contractor you trust, keep him. We are glad to work beside the
      locals, not against them.
    </p>
  </div>
</BaseLayout>
