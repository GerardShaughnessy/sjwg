---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import Banner from '@/components/ui/Banner.astro';
import PortalApp from '@/components/portal/PortalApp';
import { getAreas } from '@/lib/trades';

const members = (await getCollection('members')).map((m) => m.data);
const events = (await getCollection('events')).map((e) => e.data);
const areas = getAreas(members);
---

<BaseLayout
  title="Member portal"
  description="Job board, calendar, directory entry, blog drafts, and donor records for Guild members."
  noindex
>
  <PageHeader title="Member portal" />
  <div class="wrap py-10 md:py-14">
    <Banner class="mb-8">
      <strong>Demo portal.</strong> Everything here is stored in this browser only. No account
      exists on a server, and nothing is sent anywhere.
    </Banner>
    <PortalApp client:only="react" members={members} events={events} areas={areas}>
      <div slot="fallback" aria-busy="true">
        <p class="font-sans text-ash">Loading the portal.</p>
        <noscript>
          <p class="mt-3">The member portal needs JavaScript.</p>
        </noscript>
      </div>
    </PortalApp>
  </div>
</BaseLayout>
