---
import '@fontsource-variable/archivo';
import '@fontsource/libre-caslon-text/400.css';
import '@fontsource/libre-caslon-text/400-italic.css';
import '@fontsource/libre-caslon-text/700.css';
import '@/styles/global.css';

import SeoHead from '@/components/site/SeoHead.astro';
import SkipLink from '@/components/site/SkipLink.astro';
import Nav from '@/components/site/Nav.astro';
import Footer from '@/components/site/Footer.astro';
import FirstVisitDialog from '@/components/site/FirstVisitDialog.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** The request-help route never shows the welcome notice or asks for money. */
  suppressWelcome?: boolean;
}
const { title, description, noindex = false, suppressWelcome = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2b2624" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <SeoHead title={title} description={description} noindex={noindex} />
    <slot name="head" />
  </head>
  <body class="flex min-h-svh flex-col">
    <SkipLink />
    <Nav />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    {!suppressWelcome && <FirstVisitDialog />}
  </body>
</html>
